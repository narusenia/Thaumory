{
  "multipart": [
    {
      "apply": {
        "model": "thaumory:block/chalk_line_mark"
      }
    },
    {
      "apply": {
        "model": "thaumory:block/chalk_line_arm"
      },
      "when": {
        "north": "true"
      }
    },
    {
      "apply": {
        "model": "thaumory:block/chalk_line_arm",
        "y": 90
      },
      "when": {
        "east": "true"
      }
    },
    {
      "apply": {
        "model": "thaumory:block/chalk_line_arm",
        "y": 180
      },
      "when": {
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "thaumory:block/chalk_line_arm",
        "y": 270
      },
      "when": {
        "west": "true"
      }
    }
  ]
}